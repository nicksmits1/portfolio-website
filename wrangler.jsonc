// Cloudflare Workers static assets: the site is fully static, so the Worker only serves dist/.
// Keeping this file stops `wrangler deploy` from auto-configuring an SSR adapter.
{
  "name": "portfolio-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // the domain is registered on Cloudflare; each deploy attaches it to this Worker and keeps its certificate
  "routes": [
    { "pattern": "nicolas-smits.com", "custom_domain": true },
    { "pattern": "www.nicolas-smits.com", "custom_domain": true }
  ],
  // branch builds run `npx wrangler preview`, which refuses to start without this block (it may stay empty)
  "previews": {}
}
