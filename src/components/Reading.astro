---
import { href, image, url } from '../lib/assets';
interface Item { title: string; what: string; href: string; preview?: string; logo?: string; wide?: boolean }
interface Props { owner: string; items: Item[] }
const { owner, items } = Astro.props;
const logo = (name: string) => (name.endsWith('.svg') ? { src: url(owner, name), width: undefined, height: undefined } : image(owner, name));
---
<section class="reading" aria-labelledby="reading-h">
  <h2 id="reading-h">Further reading</h2>
  <ul>
    {items.map(it => {
      const target = href(owner, it.href), pdf = target.endsWith('.pdf') || /\.pdf$/.test(it.href);
      const pv = it.preview ? image(owner, it.preview) : null, lg = it.logo ? logo(it.logo) : null;
      return (
        <li class:list={{ wide: it.wide }}>
          <a href={target} data-pdf={pdf ? it.title : undefined} target={pdf ? undefined : '_blank'} rel={pdf ? undefined : 'noopener'}>
            {pv
              ? <span class="pv"><img src={pv.src} width={pv.width} height={pv.height} alt="" loading="lazy" decoding="async" /></span>
              : lg && <span class="pv logo"><img src={lg.src} width={lg.width} height={lg.height} alt="" loading="lazy" /></span>}
            <span class="mk">{pv && lg && <img src={lg.src} alt="" />}<b>{it.title}</b></span>
            <span>{it.what}</span>
            <span class="act">{pdf ? 'Preview PDF' : 'Open ↗'}</span>
          </a>
        </li>
      );
    })}
  </ul>
</section>
<script>import '../scripts/pdf';</script>
