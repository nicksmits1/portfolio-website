---
/* The nav on its ink tab, top right of every landscape. On project pages the section links go back to home. */
import { cvUrl } from '../lib/assets';
interface Props { page: 'home' | 'project' }
const { page } = Astro.props;
const at = (hash: string) => (page === 'home' ? `#${hash}` : `/#${hash}`);
---
<nav class="nav" aria-label="Site">
  <a href={at('research')} aria-current={page === 'project' ? 'page' : undefined}>Research</a>
  <a class="wide" href={at('publications')}>Publications</a>
  <a class="wide" href={at('experience')}>Experience</a>
  <a class="wide" href={at('skills')}>Skills</a>
  <a href={cvUrl}>CV</a>
  <a href="#contact">Contact</a>
</nav>
