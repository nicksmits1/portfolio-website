---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { ICON } from '../lib/icons';
import { thumb } from '../lib/thumbs';
import { image, cvUrl } from '../lib/assets';
import { projects, body, skillsOf, profile, TOPICS, timelineNewest, publicationsNewest } from '../lib/site';

const list = await projects();
const refs = JSON.stringify(list.map(p => ({ id: p.id, short: p.data.short })));
/* the hero's minima are research topics; each project names its topics, home topic first */
const topics = TOPICS.map(t => ({ ...t, n: list.filter(p => p.data.topics.includes(t.id)).length }));
const topicName = Object.fromEntries(topics.map(t => [t.id, t.name]));
for (const p of list) for (const t of p.data.topics) if (!topicName[t]) throw new Error(`${p.id} lists topic "${t}", which is not in content/data/topics.yaml`);
for (const t of topics) if (!t.n) throw new Error(`Topic ${t.id} has no projects; give one a topics entry or remove it from content/data/topics.yaml`);
const latest = (await getCollection('latest')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 4);
const pubs = await publicationsNewest();
const timeline = await timelineNewest();
const groups = (await getCollection('skills')).map(g => ({
  name: g.data.name,
  skills: g.data.skills.map(s => ({ s, uses: list.filter(p => skillsOf(p).includes(s)).map(p => p.id) })).filter(x => x.uses.length),
})).filter(g => g.skills.length);
const head = image('profile', 'headshot-square.webp');
const [first, ...rest] = profile.name.split(' ');
---
<Base title="Nicolas Smits" description={`${profile.name}: ${profile.focus}`}>
  {/* the hero holds for one screen of scrolling while the camera dives down the descent (home.ts), then scrolls away */}
  <div class="hero-pin">
  <header class="hero" id="top">
    <div class="land" data-land="hero" data-topics={JSON.stringify(topics)}>
      <canvas role="img" aria-label="Contour landscape of an objective function with one local minimum per research topic around a flat basin under the name; a gradient-descent solver converges on one of them"></canvas>
      <svg aria-hidden="true"></svg><div class="labs"></div>
    </div>
    <Nav page="home" />
    {/* the landscape's function as its caption; clicking it rotates through the functions (home.ts shows it) */}
    <button class="fx-tab" type="button" data-fx hidden><span class="eq" data-fx-eq></span><span class="nm"><i>f</i><span data-fx-name></span></span><span class="nx">Next<Fragment set:html={ICON.next} /></span></button>
    <div class="who">
      <div class="id"><img src={head.src} width={head.width} height={head.height} alt={profile.name} /><h1>{first}<br />{rest.join(' ')}</h1></div>
      <p class="focus">{profile.focus}</p>
      <div class="links">
        <a href={`mailto:${profile.email}`} aria-label="Email"><Fragment set:html={ICON.mail} /><span class="nm">Email</span></a>
        <a href={profile.linkedin} aria-label="LinkedIn"><Fragment set:html={ICON.li} /><span class="nm">LinkedIn</span></a>
        <a href={profile.github} aria-label="GitHub"><Fragment set:html={ICON.gh} /><span class="nm">GitHub</span></a>
        {profile.orcid
          ? <a href={profile.orcid} aria-label="ORCID"><Fragment set:html={ICON.orcid} /><span class="nm">ORCID</span></a>
          : <span class="tbd" aria-label="ORCID, coming soon" title="ORCID, coming soon"><Fragment set:html={ICON.orcid} /><span class="nm">ORCID</span></span>}
        <a class="cv" href={cvUrl}><Fragment set:html={ICON.file} />CV</a>
      </div>
      <p class="read" data-read aria-live="polite">Click anywhere to start a solver there.</p>
    </div>
    {/* Latest runs as a slow reel across the hero's lower edge; the second set is the loop's seam, hidden from assistive tech */}
    <section class="reel" aria-labelledby="latest-h" data-reel>
      <h2 class="reel-label" id="latest-h">Latest</h2>
      <div class="win"><div class="track">{[false, true].map(copy => (
        <ol class="set" aria-hidden={copy ? 'true' : undefined}>{latest.map(n => (
          <li>
            {n.data.href
              ? <a class="card" href={n.data.href} tabindex={copy ? -1 : undefined}><em><i>{n.data.label}</i><i>{n.data.kind}</i></em><b>{n.data.title}</b><span>{n.data.detail}</span></a>
              : <div class="card"><em><i>{n.data.label}</i><i>{n.data.kind}</i></em><b>{n.data.title}</b><span>{n.data.detail}</span></div>}
            <svg class="mk" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="8" /><circle cx="9" cy="9" r="5" /><circle cx="9" cy="9" r="2" /></svg>
          </li>
        ))}</ol>
      ))}</div></div>
    </section>
  </header>
  </div>

  <main id="main" class="wrap">
    <section class="block" id="research" aria-labelledby="research-h">
      <h2 class="sec-h" id="research-h">Research and projects</h2>
      <div class="chips topics" role="group" aria-label="Show one topic" data-topic-chips>
        <button type="button" data-topic="" aria-pressed="true">All<small>{list.length}</small></button>
        {topics.map(t => <button type="button" data-topic={t.id} aria-pressed="false">{t.name}<small>{t.n}</small></button>)}
      </div>
      <ul class="rows">{list.map(p => (
        <li data-topics={p.data.topics.join(' ')}><a class="row" href={`/projects/${p.id}`}><Fragment set:html={thumb(p.id)} /><div><b>{p.data.name}</b><small>{p.data.where}</small><span class="tps">{p.data.topics.map(t => <span>{topicName[t]}</span>)}</span></div><p>{body(p).line}</p><em>{p.data.year}</em></a></li>
      ))}</ul>
    </section>

    <section class="block two">
      <div id="publications">
        <h2 class="sec-h">Publications</h2>
        <ul class="items">{pubs.map(x => (
          <li class="item"><em>{x.data.year}</em><div>{x.data.href ? <a href={x.data.href}><b>{x.data.title}{x.data.status && <span class="status">{x.data.status}</span>}</b></a> : <b>{x.data.title}</b>}<span>{x.data.kind}, {x.data.venue}</span></div></li>
        ))}</ul>
        <a class="more" href="/publications">All publications<Fragment set:html={ICON.next} /></a>
      </div>
      <div id="experience">
        <h2 class="sec-h">Experience and education</h2>
        {(['Experience', 'Teaching', 'Education'] as const).map(g => (
          <>
            <p class="subh">{g}</p>
            <ul class="items">{timeline.filter(x => x.data.group === g).map(x => <li class="item"><em>{x.data.years}</em><div><b>{x.data.title}</b><span>{x.data.detail}</span>{x.data.topics.length > 0 && <span class="tps">{x.data.topics.map(t => <span>{t}</span>)}</span>}</div></li>)}</ul>
            {g === 'Experience' && <a class="more" href="/experience">Each role in detail<Fragment set:html={ICON.next} /></a>}
          </>
        ))}
      </div>
    </section>
  </main>

  <section class="skills" id="skills" aria-labelledby="skills-h">
    <div class="skills-l">
      <h2 id="skills-h">Skills</h2>
      <p class="read" data-read aria-live="polite">Pick a skill. The projects that use it stay deep; the rest flatten out.</p>
      {groups.map(g => (
        <div class="grp"><p class="eyebrow">{g.name}</p><div class="chips">{g.skills.map(x => <button type="button" data-skill={x.s} data-uses={x.uses.join(',')} aria-pressed="false">{x.s}</button>)}</div></div>
      ))}
    </div>
    <div class="skills-r">
      <div class="land" data-land="skills" data-projects={refs}>
        <canvas role="img" aria-label="The same landscape laid out on a grid; picking a skill flattens the projects that do not use it"></canvas>
        <svg aria-hidden="true"></svg><div class="labs"></div>
      </div>
    </div>
  </section>
  <script>import '../scripts/home';</script>
</Base>
